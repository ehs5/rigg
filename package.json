{
  "name": "create-rigg",
  "version": "0.1.4",
  "description": "Create Node.js TypeScript projects using the Vite+ Toolchain - for everything outside the browser.",
  "keywords": [
    "backend",
    "create-rigg",
    "express",
    "fastify",
    "framework",
    "hono",
    "node",
    "nodejs",
    "oxfmt",
    "oxlint",
    "rigg",
    "scaffolder",
    "toolchain",
    "tsdown",
    "tsx",
    "typescript",
    "vite+",
    "vite-plus",
    "viteplus",
    "vitest"
  ],
  "license": "MIT",
  "author": "Espen Steen",
  "repository": {
    "type": "git",
    "url": "https://github.com/ehs5/rigg.git"
  },
  "bin": {
    "create-rigg": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "template"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "oxlint && oxfmt --check && tsc --noEmit",
    "dev": "tsx src/index.ts",
    "build": "tsdown src/index.ts",
    "start": "node dist/index.mjs",
    "prepublishOnly": "git diff --exit-code && git diff --cached --exit-code && oxlint && oxfmt && tsc --noEmit && vitest run && pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cross-spawn": "^7.0.6",
    "mri": "^1.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.13.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.30.3"
}
